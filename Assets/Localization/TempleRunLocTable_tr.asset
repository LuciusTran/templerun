  - m_Id: 306467004473344
    m_Localized: Kalıcı Kanatlar
    m_Metadata:
      m_Items: []
  - m_Id: 306467004473345
    m_Localized: Etkinleştirmek için oyunun başında oyunu duraklatıp Kalıcı Kanatlar aracını seç. Ölünce hemen otomatik olarak dirilirsin.
    m_Metadata:
      m_Items: []
  - m_Id: 306467008667648
    m_Localized: Oyunun başlangıcında 1.000 m öne geç.
    m_Metadata:
      m_Items: []
  - m_Id: 306467012861952
    m_Localized: Avantajlı Başlangıç
    m_Metadata:
      m_Items: []
  - m_Id: 306467012861953
    m_Localized: Takviyeyle 1.000 m öne geçmek için oyunun başlangıcında oyunu duraklatıp Avantajlı Başlangıç aracını seç.
    m_Metadata:
      m_Items: []
  - m_Id: 306467017056256
    m_Localized: Oyunun başlangıcında 2.500 m öne geç.
    m_Metadata:
      m_Items: []
  - m_Id: 306467021250560
    m_Localized: Mega Avantajlı Başlangıç
    m_Metadata:
      m_Items: []
  - m_Id: 306467025444864
    m_Localized: Takviyeyle 2.500 m öne geçmek için oyunun başlangıcında oyunu duraklatıp Mega Avantajlı Başlangıç aracını seç.
    m_Metadata:
