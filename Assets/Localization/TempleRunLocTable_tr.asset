  - m_Id: 306466970918912
    m_Localized: EN ÜST SEVİYEYE YÜKSELTİLDİ
    m_Metadata:
      m_Items: []
  - m_Id: 306466975113216
    m_Localized: ARAÇLAR
    m_Metadata:
      m_Items: []
  - m_Id: 306466975113217
    m_Localized: Aktive edersen öldükten hemen sonra dirilirsin.
    m_Metadata:
      m_Items: []
  - m_Id: 306466979307520
    m_Localized: TEK KULLANIMLIK
    m_Metadata:
      m_Items: []
  - m_Id: 306466983501824
    m_Localized: Diriliş Kanatları
    m_Metadata:
      m_Items: []
  - m_Id: 306466983501825
    m_Localized: 'Koşarken ekrana iki kez dokunarak etkinleştir veya oyunu duraklatıp Diriliş Kanatları aracını seç. Etkinleştirdikten sonra etkisi 30 saniye sürer. '
    m_Metadata:
      m_Items: []
  - m_Id: 306466987696128
    m_Localized: 'Koşarken merkezi düğmeyi 1 saniye boyunca basılı tutarak etkinleştir veya oyunu duraklatıp Diriliş Kanatları aracını seç. Etkinleştirdikten sonra etkisi 30 saniye sürer. '
    m_Metadata:
      m_Items: []
  - m_Id: 306466987696129
    m_Localized: 'Koşarken oyun kumandasında kuzey (Y/△) düğmesine basarak etkinleştir veya oyunu duraklatıp Diriliş Kanatları aracını seç. Etkinleştirdikten sonra etkisi 30 saniye sürer. '
    m_Metadata:
      m_Items: []
  - m_Id: 306466991890432
    m_Localized: 'Koşarken [R] tuşuna basarak etkinleştir veya oyunu duraklatıp Diriliş Kanatları aracını seç. Etkinleştirdikten sonra etkisi 30 saniye sürer. '
    m_Metadata:
      m_Items: []
  - m_Id: 306466996084736
    m_Localized: Tamam
    m_Metadata:
      m_Items: []
  - m_Id: 306466996084737
    m_Localized: TAMAM
    m_Metadata:
      m_Items: []
  - m_Id: 306467000279040
