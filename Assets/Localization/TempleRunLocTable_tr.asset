    m_Metadata:
      m_Items: []
  - m_Id: 306468233404417
    m_Localized: Temple Run'ı sevdin mi?
    m_Metadata:
      m_Items: []
  - m_Id: 306468237598720
    m_Localized: Lütfen bize bir yorum bırak!
    m_Metadata:
