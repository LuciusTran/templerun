    m_Metadata:
      m_Items: []
  - m_Id: 306468279541760
    m_Localized: 'Tempo rimanente:'
    m_Metadata:
      m_Items: []
  - m_Id: 306468283736064
    m_Localized: Sfida distanza - Corsa singola
    m_Metadata:
      m_Items: []
  - m_Id: 306468287930368
    m_Localized: Sfida distanza - Più corse
    m_Metadata:
      m_Items: []
  - m_Id: 306468287930369
    m_Localized: Sfida punteggio - Corsa singola
    m_Metadata:
      m_Items: []
  - m_Id: 306468292124672
    m_Localized: Sfida punteggio - Più corse
    m_Metadata:
      m_Items: []
  - m_Id: 306468296318976
    m_Localized: Sfida monete - Corsa singola
    m_Metadata:
      m_Items: []
  - m_Id: 306468296318977
    m_Localized: Sfida monete - Più corse
    m_Metadata:
      m_Items: []
  - m_Id: 306468300513280
    m_Localized: Sfida potenziamento - Corsa singola
    m_Metadata:
      m_Items: []
  - m_Id: 306468304707584
    m_Localized: Per superare questa sfida, raggiungi la distanza necessaria in una corsa singola!
    m_Metadata:
      m_Items: []
  - m_Id: 306468304707585
    m_Localized: Per superare questa sfida, raggiungi la distanza necessaria in più corse!
    m_Metadata:
      m_Items: []
  - m_Id: 306468308901888
    m_Localized: Per superare questa sfida, raggiungi il punteggio necessario in una corsa singola!
    m_Metadata:
      m_Items: []
  - m_Id: 306468313096192
    m_Localized: Per superare questa sfida, raggiungi il punteggio necessario in più corse!
    m_Metadata:
      m_Items: []
  - m_Id: 306468313096193
    m_Localized: 'Per superare questa sfida, raggiungi la quantità di monete necessaria in una corsa singola! '
    m_Metadata:
      m_Items: []
  - m_Id: 306468317290496
    m_Localized: 'Per superare questa sfida, raggiungi la quantità di monete necessaria in più corse! '
    m_Metadata:
      m_Items: []
  - m_Id: 306468321484800
    m_Localized: 'Per superare questa sfida, raggiungi la quantità di potenziamenti necessaria in una corsa singola! '
    m_Metadata:
      m_Items: []
  - m_Id: 306468321484801
