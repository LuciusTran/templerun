    m_Metadata:
      m_Items: []
  - m_Id: 306468271153152
    m_Localized: Vuoi CANCELLARE definitivamente i progressi nella sfida settimanale, i miglioramenti e le statistiche dello slot [{0}]?
    m_Metadata:
      m_Items: []
  - m_Id: 306468271153153
