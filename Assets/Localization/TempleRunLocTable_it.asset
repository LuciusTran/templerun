      m_Items: []
  - m_Id: 306468233404417
    m_Localized: Ti piace Temple Run?
    m_Metadata:
      m_Items: []
  - m_Id: 306468237598720
    m_Localized: Faccelo sapere lasciando una recensione!
    m_Metadata:
      m_Items: []
