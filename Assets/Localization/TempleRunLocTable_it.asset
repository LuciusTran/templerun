    m_Metadata:
      m_Items: []
  - m_Id: 306468250181632
    m_Localized: Seleziona uno slot per salvare i progressi nella sfida settimanale, i miglioramenti e le statistiche.
    m_Metadata:
      m_Items: []
  - m_Id: 306468250181633
    m_Localized: '[{0}] (Slot attuale)'
