      m_Items: []
  - m_Id: 306466979307520
    m_Localized: EENMALIG GEBRUIK
    m_Metadata:
      m_Items: []
  - m_Id: 306466983501824
    m_Localized: Opstandingsvleugels
    m_Metadata:
      m_Items: []
  - m_Id: 306466983501825
    m_Localized: 'Activeer tijdens de tocht door dubbel op het scherm te tikken, of het spel te pauzeren en het hulpmiddel Opstandingsvleugels te selecteren. Na activering 30 seconden actief. '
    m_Metadata:
      m_Items: []
  - m_Id: 306466987696128
    m_Localized: 'Activeer tijdens de tocht door de middelste knop 1 seconde vast te houden, of het spel te pauzeren en het hulpmiddel Opstandingsvleugels te selecteren. Na activering 30 seconden actief. '
    m_Metadata:
      m_Items: []
  - m_Id: 306466987696129
    m_Localized: 'Activeer tijdens de tocht door op de bovenste (Y/△) gamepad-knop te drukken, of het spel te pauzeren en het hulpmiddel Opstandingsvleugels te selecteren. Na activering 30 seconden actief. '
    m_Metadata:
      m_Items: []
  - m_Id: 306466991890432
    m_Localized: 'Activeer tijdens de tocht door op de [R]-toets te drukken, of het spel te pauzeren en het hulpmiddel Opstandingsvleugels te selecteren. Na activering 30 seconden actief. '
    m_Metadata:
      m_Items: []
