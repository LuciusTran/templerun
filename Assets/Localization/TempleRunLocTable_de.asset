  - m_Id: 306466970918912
    m_Localized: MAXIMAL VERBESSERT
    m_Metadata:
      m_Items: []
  - m_Id: 306466975113216
    m_Localized: NÜTZLICHES
    m_Metadata:
      m_Items: []
  - m_Id: 306466975113217
    m_Localized: Bei Aktivierung wirst du nach dem Tod sofort wiederbelebt.
    m_Metadata:
      m_Items: []
  - m_Id: 306466979307520
    m_Localized: EINMALIGE BENUTZUNG
    m_Metadata:
      m_Items: []
  - m_Id: 306466983501824
    m_Localized: Wiederauferstehung flügel
    m_Metadata:
      m_Items: []
  - m_Id: 306466983501825
    m_Localized: 'Tippe bei einem Durchlauf zweimal auf den Bildschirm, um die Wiederauf.-Flügel zu aktivieren, oder wähle sie über das Pausenmenü. Sie halten 30 Sek. lang an. '
    m_Metadata:
      m_Items: []
  - m_Id: 306466987696128
    m_Localized: 'Halte bei einem Durchlauf die Touch-Oberfläche 1 Sek. lang gedrückt, um die Wiederauf.-Flügel zu aktivieren, oder wähle sie über das Pausenmenü. Sie halten 30 Sek. lang an. '
    m_Metadata:
      m_Items: []
  - m_Id: 306466987696129
    m_Localized: 'Drücke bei einem Durchlauf die obere Taste (Y/△) auf dem Controller, um die Wiederauf.-Flügel zu aktivieren, oder wähle sie über das Pausenmenü. Sie halten 30 Sek. lang an. '
    m_Metadata:
      m_Items: []
  - m_Id: 306466991890432
    m_Localized: 'Drücke bei einem Durchlauf die [R]-Taste, um die Wiederauf.-Flügel zu aktivieren, oder wähle sie über das Pausenmenü. Sie halten 30 Sek. lang an. '
    m_Metadata:
      m_Items: []
  - m_Id: 306466996084736
    m_Localized: Okay
    m_Metadata:
      m_Items: []
  - m_Id: 306466996084737
    m_Localized: OK
    m_Metadata:
      m_Items: []
  - m_Id: 306467000279040
    m_Localized: Wiederauferstehungs-\nflügel, die permanent aktiv sind.
    m_Metadata:
      m_Items: []
  - m_Id: 306467004473344
    m_Localized: Permaflügel
    m_Metadata:
      m_Items: []
  - m_Id: 306467004473345
    m_Localized: Pausiere das Spiel und wähle vor einem Durchlauf die Permaflügel aus, um sie zu aktivieren. Wenn du stirbst, wirst du automatisch wiederbelebt.
    m_Metadata:
      m_Items: []
  - m_Id: 306467008667648
    m_Localized: Genieße zu Beginn des Spiels einen Vorsprung von 1.000 m.
    m_Metadata:
      m_Items: []
  - m_Id: 306467012861952
    m_Localized: Vorsprung
    m_Metadata:
      m_Items: []
  - m_Id: 306467012861953
    m_Localized: Pausiere das Spiel und wähle vor einem Durchlauf den Vorsprung aus, um sofort 1.000 m voranzukommen.
    m_Metadata:
      m_Items: []
  - m_Id: 306467017056256
    m_Localized: Genieße zu Beginn des Spiels einen Mega-Boost von 2.500 m.
    m_Metadata:
      m_Items: []
  - m_Id: 306467021250560
    m_Localized: Mega-Vorsprung
    m_Metadata:
      m_Items: []
  - m_Id: 306467025444864
    m_Localized: Pausiere das Spiel und wähle vor einem Durchlauf den Mega-Vorsprung aus, um sofort 2.500 m voranzukommen.
    m_Metadata:
      m_Items: []
