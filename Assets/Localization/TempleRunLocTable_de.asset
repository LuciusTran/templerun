  - m_Id: 306468233404417
    m_Localized: Macht Temple Run dir Spaß?
    m_Metadata:
      m_Items: []
  - m_Id: 306468237598720
    m_Localized: Bitte hinterlasse uns eine Bewertung!
    m_Metadata:
