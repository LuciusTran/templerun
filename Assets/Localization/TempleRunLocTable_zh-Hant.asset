      m_Items: []
  - m_Id: 306468438925313
    m_Localized: 金幣
    m_Metadata:
      m_Items: []
  - m_Id: 306468443119616
    m_Localized: 積分
    m_Metadata:
      m_Items: []
  - m_Id: 306468447313920
    m_Localized: 強化道具
    m_Metadata:
      m_Items: []
  - m_Id: 306468447313921
    m_Localized: 需要控制器或遙控器才能繼續。
    m_Metadata:
      m_Items: []
  - m_Id: 306468451508224
    m_Localized: 每週高分（UTC 時間星期一中午重置）
    m_Metadata:
      m_Items: []
  - m_Id: 306468455702528
